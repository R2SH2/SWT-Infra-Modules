# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore Mac .DS_Store files
.DS_Store

# Ignore provider lock files (optional - uncomment if you want to commit)
# .terraform.lock.hcl

# Ignore backup files
*.backup
*.bak
*~

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*.swn
.project
.settings/

# OS specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Ignore test binary files
*.exe
*.dll
*.so
*.dylib
bin/
tmp/

# Test cache
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/

# Go test files
*.test

# Coverage
*.out
coverage.xml
coverage.html

# Terraform documentation (auto-generated)
# Uncomment if you don't want to commit auto-generated docs
# **/README.md

# Sensitive files
*.pem
*.key
*.crt
secrets.yml
secrets.yaml
.env
.env.local
